; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Cadmium"
config/description="Pattern-based music production: channel rack, piano roll, playlist, mixer, VST3."
config/version="1.0.0"
run/main_scene="res://ui/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/bg_color=Color(0.145098, 0.145098, 0.145098, 1)
boot_splash/image="res://resources/boot_splash.png"
boot_splash/fullsize=false
boot_splash/use_filter=false
boot_splash/minimum_display_time=500
config/icon="res://icon.svg"

[audio]

driver/mix_rate=48000

[autoload]

Settings="*res://autoload/settings.gd"
Accent="*res://autoload/accent.gd"
Secondary="*res://autoload/secondary.gd"
Icons="*res://autoload/icons.gd"
Audio="*res://autoload/audio.gd"
Plugins="*res://autoload/plugins.gd"
App="*res://autoload/app.gd"
Shortcuts="*res://autoload/shortcuts.gd"
Addons="*res://autoload/addons.gd"

[debug]

file_logging/enable_file_logging=true
file_logging/max_log_files=3

[display]

window/size/viewport_width=1760
window/size/viewport_height=1000
window/energy_saving/keep_screen_on=false
display_server/driver.linuxbsd="x11"

[editor]

export/convert_text_resources_to_binary=false

[file_customization]

folder_colors={
"res://core/": "red",
"res://native/": "purple",
"res://ui/": "green"
}

[gui]

timers/tooltip_delay_sec=0.35
theme/custom="res://themes/cadmium_theme.tres"
common/drop_mouse_on_gui_input_disabled=true

[importer_defaults]

texture={
"detect_3d/compress_to": 0,
"mipmaps/generate": true,
"svg/scale": 4.0
}

[rendering]

textures/lossless_compression/force_png=true
environment/defaults/default_clear_color=Color(0.247, 0.247, 0.247, 1)
