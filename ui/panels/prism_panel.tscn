; Prism's picture: the name of what is loaded, the button that loads another,
; and the picture itself with the scan line running over it. The panel takes a
; drop as well as a click, so a picture can come straight off the desktop.
[gd_scene load_steps=3 format=3 uid="uid://cdprismpanel"]

[ext_resource type="Script" path="res://ui/panels/prism_panel.gd" id="1"]
[ext_resource type="PackedScene" path="res://ui/widgets/views/prism_view.tscn" id="2"]

[node name="PrismPanel" type="PanelContainer"]
theme_type_variation = &"Card"
script = ExtResource("1")

[node name="Col" type="VBoxContainer" parent="."]
layout_mode = 2

[node name="Row" type="HBoxContainer" parent="Col"]
layout_mode = 2

[node name="Name" type="Label" parent="Col/Row"]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"MuteLabel"
text = "no picture yet - drop one here, or load one, and play a key"
clip_text = true

[node name="Load" type="Button" parent="Col/Row"]
layout_mode = 2
focus_mode = 0
text = "Load Picture..."

[node name="View" parent="Col" instance=ExtResource("2")]
layout_mode = 2
