; The browser's chrome. The tree's contents are built in browser.gd, because
; they are whatever is installed and whatever the project holds -- a scene
; cannot know that.
[gd_scene load_steps=2 format=3 uid="uid://cdbrowser"]

[ext_resource type="Script" path="res://ui/panels/browser.gd" id="1"]

[node name="Browser" type="PanelContainer"]
theme_type_variation = &"Dock"
script = ExtResource("1")

[node name="Col" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 2

[node name="Caption" type="PanelContainer" parent="Col"]
layout_mode = 2
theme_type_variation = &"CaptionBar"

[node name="Row" type="HBoxContainer" parent="Col/Caption"]
layout_mode = 2

[node name="Icon" type="TextureRect" parent="Col/Caption/Row"]
layout_mode = 2
stretch_mode = 4

[node name="Title" type="Label" parent="Col/Caption/Row"]
layout_mode = 2
text = "BROWSER"
theme_type_variation = &"Caption"

[node name="Spacer" type="Control" parent="Col/Caption/Row"]
layout_mode = 2
size_flags_horizontal = 3

[node name="Listen" type="Button" parent="Col/Caption/Row"]
custom_minimum_size = Vector2(22, 22)
layout_mode = 2
size_flags_vertical = 4
focus_mode = 0
toggle_mode = true
button_pressed = true
tooltip_text = "Play a file when you click it; click it again to stop"

[node name="Rescan" type="Button" parent="Col/Caption/Row"]
custom_minimum_size = Vector2(22, 22)
layout_mode = 2
size_flags_vertical = 4
focus_mode = 0
tooltip_text = "Rescan VST3 plugins"

[node name="Search" type="LineEdit" parent="Col"]
layout_mode = 2
placeholder_text = "Filter..."
clear_button_enabled = true

[node name="Tree" type="Tree" parent="Col"]
layout_mode = 2
size_flags_vertical = 3
allow_rmb_select = true
hide_root = true
