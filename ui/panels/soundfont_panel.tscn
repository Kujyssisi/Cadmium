; The soundfont player's panel: the loaded file, the fonts already installed on
; the machine, and the list of presets inside the one that is open. A .sf2
; dropped on the panel loads it.
[gd_scene load_steps=2 format=3 uid="uid://cdsoundfontpanel"]

[ext_resource type="Script" path="res://ui/panels/soundfont_panel.gd" id="1"]

[node name="SoundfontPanel" type="PanelContainer"]
theme_type_variation = &"Card"
script = ExtResource("1")

[node name="Col" type="VBoxContainer" parent="."]
layout_mode = 2

[node name="Row" type="HBoxContainer" parent="Col"]
layout_mode = 2

[node name="Name" type="Label" parent="Col/Row"]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"MuteLabel"
text = "no soundfont loaded - drop an .sf2 here"
clip_text = true

[node name="Installed" type="MenuButton" parent="Col/Row"]
layout_mode = 2
focus_mode = 0
text = "Installed"

[node name="Load" type="Button" parent="Col/Row"]
layout_mode = 2
focus_mode = 0
text = "Load .sf2..."

[node name="Search" type="LineEdit" parent="Col"]
layout_mode = 2
placeholder_text = "Filter presets..."
clear_button_enabled = true

[node name="List" type="ItemList" parent="Col"]
custom_minimum_size = Vector2(0, 190)
layout_mode = 2
size_flags_horizontal = 3
