; A plugin's window: the strip along the top and the space under it. What goes
; in that space is the plugin's -- either its own interface drawn into a child
; window, or a panel of controls built from whatever parameters it publishes --
; so the body is filled in plugin_window.gd.
[gd_scene load_steps=5 format=3 uid="uid://cdpluginwindow"]

[ext_resource type="Script" path="res://ui/panels/plugin_window.gd" id="1"]
[ext_resource type="Script" path="res://ui/widgets/knob.gd" id="2"]
[ext_resource type="Script" path="res://ui/widgets/mini_keys.gd" id="3"]
[ext_resource type="Script" path="res://ui/widgets/spinner.gd" id="4"]

[node name="PluginWindow" type="Window"]
title = "Plugin"
size = Vector2i(560, 470)
transient = true
script = ExtResource("1")

[node name="Root" type="PanelContainer" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_type_variation = &"Dock"

[node name="Col" type="VBoxContainer" parent="Root"]
layout_mode = 2
theme_override_constants/separation = 3

[node name="Header" type="PanelContainer" parent="Root/Col"]
custom_minimum_size = Vector2(0, 30)
layout_mode = 2
theme_type_variation = &"CaptionBar"

[node name="Row" type="HBoxContainer" parent="Root/Col/Header"]
layout_mode = 2

[node name="Icon" type="TextureRect" parent="Root/Col/Header/Row"]
layout_mode = 2
stretch_mode = 4

[node name="Name" type="Label" parent="Root/Col/Header/Row"]
layout_mode = 2
text = "Plugin"
theme_type_variation = &"Header"

[node name="Kind" type="Label" parent="Root/Col/Header/Row"]
layout_mode = 2
theme_type_variation = &"MuteLabel"

[node name="Spacer" type="Control" parent="Root/Col/Header/Row"]
layout_mode = 2
size_flags_horizontal = 3

[node name="Bypass" type="Button" parent="Root/Col/Header/Row"]
visible = false
layout_mode = 2
focus_mode = 0
toggle_mode = true
text = "Bypass"

[node name="Wet" type="Control" parent="Root/Col/Header/Row"]
visible = false
custom_minimum_size = Vector2(26, 26)
layout_mode = 2
tooltip_text = "Dry / wet for the whole plugin"
script = ExtResource("2")
label = "Mix"
minimum = 0.0
maximum = 1.0
default_value = 1.0
kind = 3
show_label = false
knob_size = 22.0

[node name="PluginUi" type="CheckBox" parent="Root/Col/Header/Row"]
visible = false
layout_mode = 2
focus_mode = 0
text = "Plugin UI"

[node name="Typing" type="CheckBox" parent="Root/Col/Header/Row"]
visible = false
layout_mode = 2
focus_mode = 0
text = "Typing"
tooltip_text = "On: the computer keyboard plays notes and Cadmium's shortcuts work while this window is in front.
Off: the keyboard goes to the plugin, for typing into its own search and value boxes."

[node name="Preset" type="MenuButton" parent="Root/Col/Header/Row"]
layout_mode = 2
focus_mode = 0
text = "Preset"

[node name="Hole" type="Control" parent="Root/Col"]
visible = false
layout_mode = 2
size_flags_vertical = 3
mouse_filter = 2

[node name="Busy" type="PanelContainer" parent="Root/Col/Hole"]
visible = false
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme_type_variation = &"DarkPanel"

[node name="Box" type="VBoxContainer" parent="Root/Col/Hole/Busy"]
layout_mode = 2
size_flags_horizontal = 4
size_flags_vertical = 4
theme_override_constants/separation = 10

[node name="Spin" type="Control" parent="Root/Col/Hole/Busy/Box"]
custom_minimum_size = Vector2(44, 44)
layout_mode = 2
size_flags_horizontal = 4
script = ExtResource("4")

[node name="Label" type="Label" parent="Root/Col/Hole/Busy/Box"]
layout_mode = 2
size_flags_horizontal = 4
text = "Loading..."
theme_type_variation = &"MuteLabel"
horizontal_alignment = 1
autowrap_mode = 3

[node name="Again" type="Button" parent="Root/Col/Hole/Busy/Box"]
visible = false
layout_mode = 2
size_flags_horizontal = 4
text = "Try it again"

[node name="Scroll" type="ScrollContainer" parent="Root/Col"]
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 3

[node name="Body" type="VBoxContainer" parent="Root/Col/Scroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 4

[node name="FilterRow" type="HBoxContainer" parent="Root/Col"]
visible = false
layout_mode = 2

[node name="Field" type="LineEdit" parent="Root/Col/FilterRow"]
layout_mode = 2
size_flags_horizontal = 3
clear_button_enabled = true

[node name="Count" type="Label" parent="Root/Col/FilterRow"]
layout_mode = 2
theme_type_variation = &"MuteLabel"

[node name="Keys" type="Control" parent="Root/Col"]
visible = false
