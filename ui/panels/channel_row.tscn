; One channel in the rack: its head on the left, its step grid on the right.
; The rack instances one of these per channel and tells it which it is.
[gd_scene load_steps=6 format=3 uid="uid://cdchannelrow"]

[ext_resource type="Script" path="res://ui/panels/channel_row.gd" id="1"]
[ext_resource type="Script" path="res://ui/widgets/led.gd" id="2"]
[ext_resource type="Script" path="res://ui/widgets/knob.gd" id="3"]
[ext_resource type="Script" path="res://ui/widgets/activity.gd" id="4"]
[ext_resource type="Script" path="res://ui/widgets/step_grid.gd" id="5"]

[node name="ChannelRow" type="HBoxContainer"]
custom_minimum_size = Vector2(0, 26)
theme_override_constants/separation = 3
script = ExtResource("1")

[node name="Head" type="Control" parent="."]
custom_minimum_size = Vector2(300, 26)
layout_mode = 2
mouse_filter = 1

[node name="Row" type="HBoxContainer" parent="Head"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 4

[node name="Colour" type="ColorRect" parent="Head/Row"]
custom_minimum_size = Vector2(4, 26)
layout_mode = 2

[node name="Mute" type="Control" parent="Head/Row"]
custom_minimum_size = Vector2(16, 16)
layout_mode = 2
size_flags_vertical = 4
tooltip_text = "Mute / unmute this channel"
script = ExtResource("2")

[node name="Name" type="Button" parent="Head/Row"]
custom_minimum_size = Vector2(130, 24)
layout_mode = 2
size_flags_horizontal = 3
focus_mode = 0
clip_text = true
alignment = 0

[node name="Pan" type="Control" parent="Head/Row"]
custom_minimum_size = Vector2(30, 26)
layout_mode = 2
tooltip_text = "Pan"
script = ExtResource("3")
label = "Pan"
minimum = -1.0
maximum = 1.0
default_value = 0.0
show_label = false
knob_size = 20.0

[node name="Volume" type="Control" parent="Head/Row"]
custom_minimum_size = Vector2(30, 26)
layout_mode = 2
tooltip_text = "Channel volume"
script = ExtResource("3")
label = "Volume"
minimum = 0.0
maximum = 1.25
default_value = 0.8
show_label = false
knob_size = 20.0

[node name="Layers" type="Button" parent="Head/Row"]
visible = false
custom_minimum_size = Vector2(24, 18)
layout_mode = 2
size_flags_vertical = 4
focus_mode = 0
theme_type_variation = &"Chip"

[node name="Activity" type="Control" parent="Head/Row"]
custom_minimum_size = Vector2(6, 22)
layout_mode = 2
size_flags_vertical = 4
script = ExtResource("4")

[node name="Route" type="Button" parent="Head/Row"]
custom_minimum_size = Vector2(28, 24)
layout_mode = 2
focus_mode = 0
tooltip_text = "Mixer insert this channel feeds"

[node name="Steps" type="Control" parent="."]
custom_minimum_size = Vector2(0, 26)
layout_mode = 2
size_flags_horizontal = 3
script = ExtResource("5")
