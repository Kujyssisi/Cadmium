; The playlist's picker: everything the song is made of, down the left of the
; arrangement. The rows are per item and are made from picker_row.tscn in
; picker_panel.gd.
[gd_scene load_steps=2 format=3 uid="uid://cdpickerpanel"]

[ext_resource type="Script" path="res://ui/panels/picker_panel.gd" id="1"]

[node name="PickerPanel" type="PanelContainer"]
custom_minimum_size = Vector2(104, 0)
theme_type_variation = &"Dock"
script = ExtResource("1")

[node name="Col" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 2

[node name="Tabs" type="HBoxContainer" parent="Col"]
layout_mode = 2
theme_override_constants/separation = 1

[node name="Patterns" type="Button" parent="Col/Tabs"]
custom_minimum_size = Vector2(0, 22)
layout_mode = 2
size_flags_horizontal = 3
focus_mode = 0
toggle_mode = true
button_pressed = true
tooltip_text = "The patterns in this song"

[node name="Samples" type="Button" parent="Col/Tabs"]
custom_minimum_size = Vector2(0, 22)
layout_mode = 2
size_flags_horizontal = 3
focus_mode = 0
toggle_mode = true
tooltip_text = "The audio files this song uses"

[node name="Automation" type="Button" parent="Col/Tabs"]
custom_minimum_size = Vector2(0, 22)
layout_mode = 2
size_flags_horizontal = 3
focus_mode = 0
toggle_mode = true
tooltip_text = "The automation clips in this song"

[node name="Filter" type="LineEdit" parent="Col"]
custom_minimum_size = Vector2(0, 22)
layout_mode = 2
placeholder_text = "Filter..."

[node name="Scroll" type="ScrollContainer" parent="Col"]
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="List" type="VBoxContainer" parent="Col/Scroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 1

[node name="Foot" type="HBoxContainer" parent="Col"]
layout_mode = 2
theme_override_constants/separation = 2

[node name="Add" type="Button" parent="Col/Foot"]
custom_minimum_size = Vector2(0, 22)
layout_mode = 2
size_flags_horizontal = 3
focus_mode = 0
text = "Add"

[node name="Count" type="Label" parent="Col/Foot"]
layout_mode = 2
size_flags_vertical = 4
theme_type_variation = &"MuteLabel"
