; The sampler's file row and its waveform. Dropping an audio file on the panel
; loads it, the same as picking one with the button.
[gd_scene load_steps=3 format=3 uid="uid://cdsamplerpanel"]

[ext_resource type="Script" path="res://ui/panels/sampler_panel.gd" id="1"]
[ext_resource type="PackedScene" path="res://ui/widgets/wave_view.tscn" id="2"]

[node name="SamplerPanel" type="PanelContainer"]
theme_type_variation = &"Card"
script = ExtResource("1")

[node name="Col" type="VBoxContainer" parent="."]
layout_mode = 2

[node name="Row" type="HBoxContainer" parent="Col"]
layout_mode = 2

[node name="Name" type="Label" parent="Col/Row"]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"MuteLabel"
text = "no sample loaded - drop an audio file here"
clip_text = true

[node name="Load" type="Button" parent="Col/Row"]
layout_mode = 2
focus_mode = 0
text = "Load Sample..."

[node name="Wave" parent="Col" instance=ExtResource("2")]
custom_minimum_size = Vector2(0, 96)
layout_mode = 2
