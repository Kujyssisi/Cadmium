; One line of the playlist's picker: a pattern, an audio file or an automation
; lane. What it stands for is set by whoever instances it, in picker_row.gd.
[gd_scene load_steps=2 format=3 uid="uid://cdpickerrow"]

[ext_resource type="Script" path="res://ui/panels/picker_row.gd" id="1"]

[node name="PickerRow" type="PanelContainer"]
custom_minimum_size = Vector2(0, 28)
mouse_filter = 1
theme_type_variation = &"Card"
script = ExtResource("1")

[node name="Row" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 4

[node name="Chip" type="Control" parent="Row"]
custom_minimum_size = Vector2(4, 0)
layout_mode = 2

[node name="Name" type="Label" parent="Row"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 4
clip_text = true

[node name="Detail" type="Label" parent="Row"]
layout_mode = 2
size_flags_vertical = 4
theme_type_variation = &"MuteLabel"
