; The scope's frame. What is drawn inside it is a canvas, so that part is a
; _draw call in visualiser.gd and not something a scene can hold.
[gd_scene load_steps=2 format=3 uid="uid://cdscope"]

[ext_resource type="Script" path="res://ui/panels/visualiser.gd" id="1"]

[node name="Scope" type="PanelContainer"]
theme_type_variation = &"Dock"
script = ExtResource("1")

[node name="Col" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 0

[node name="Caption" type="PanelContainer" parent="Col"]
layout_mode = 2
theme_type_variation = &"CaptionBar"

[node name="Row" type="HBoxContainer" parent="Col/Caption"]
layout_mode = 2

[node name="Icon" type="TextureRect" parent="Col/Caption/Row"]
layout_mode = 2
stretch_mode = 4

[node name="Title" type="Label" parent="Col/Caption/Row"]
layout_mode = 2
text = "SCOPE"
theme_type_variation = &"Caption"

[node name="Spacer" type="Control" parent="Col/Caption/Row"]
layout_mode = 2
size_flags_horizontal = 3

[node name="Mode" type="OptionButton" parent="Col/Caption/Row"]
layout_mode = 2
focus_mode = 0

[node name="Canvas" type="Control" parent="Col"]
layout_mode = 2
size_flags_vertical = 3
