; One layer of a mixer strip's effect stack. The rack instances one per filled
; slot; the quick controls it folds out are the plugin's own, so those are made
; in fx_slot.gd.
[gd_scene load_steps=4 format=3 uid="uid://cdfxslot"]

[ext_resource type="Script" path="res://ui/widgets/fx_slot.gd" id="1"]
[ext_resource type="Script" path="res://ui/widgets/led.gd" id="2"]
[ext_resource type="Script" path="res://ui/widgets/knob.gd" id="3"]

[node name="FxSlot" type="PanelContainer"]
mouse_filter = 1
theme_type_variation = &"Card"
script = ExtResource("1")

[node name="Col" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 1

[node name="Head" type="HBoxContainer" parent="Col"]
custom_minimum_size = Vector2(0, 21)
layout_mode = 2
theme_override_constants/separation = 2

[node name="Grip" type="Label" parent="Col/Head"]
custom_minimum_size = Vector2(14, 0)
layout_mode = 2
mouse_filter = 1
text = "1"
horizontal_alignment = 2
tooltip_text = "Drag to move this effect up or down the chain"
theme_type_variation = &"MuteLabel"

[node name="Power" type="Control" parent="Col/Head"]
custom_minimum_size = Vector2(11, 13)
layout_mode = 2
size_flags_vertical = 4
tooltip_text = "Switch this effect in and out"
script = ExtResource("2")

[node name="Expander" type="Button" parent="Col/Head"]
custom_minimum_size = Vector2(16, 16)
layout_mode = 2
size_flags_vertical = 4
focus_mode = 0
theme_type_variation = &"Flat"
tooltip_text = "Show the main controls here"

[node name="Name" type="Button" parent="Col/Head"]
custom_minimum_size = Vector2(0, 19)
layout_mode = 2
size_flags_horizontal = 3
focus_mode = 0
clip_text = true
alignment = 0

[node name="Wet" type="Control" parent="Col/Head"]
custom_minimum_size = Vector2(20, 20)
layout_mode = 2
size_flags_vertical = 4
tooltip_text = "How much of this effect you hear"
script = ExtResource("3")
label = "Mix"
minimum = 0.0
maximum = 1.0
default_value = 1.0
kind = 3
show_label = false
knob_size = 16.0
