; Help > Check for Updates. One window for the whole thing: ask, show what
; changed, download, hand over. What it says at each step is update_dialog.gd's
; business, so everything here starts empty.
[gd_scene load_steps=2 format=3 uid="uid://cdupdatedialog"]

[ext_resource type="Script" path="res://ui/dialogs/update_dialog.gd" id="1"]

[node name="UpdateDialog" type="Window"]
title = "Check for Updates"
size = Vector2i(520, 420)
transient = true
script = ExtResource("1")

[node name="Root" type="PanelContainer" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_type_variation = &"Dialog"

[node name="Col" type="VBoxContainer" parent="Root"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Head" type="Label" parent="Root/Col"]
layout_mode = 2
text = "Cadmium"
theme_type_variation = &"SectionLabel"

[node name="State" type="Label" parent="Root/Col"]
layout_mode = 2
text = ""
autowrap_mode = 3

[node name="Bar" type="ProgressBar" parent="Root/Col"]
custom_minimum_size = Vector2(0, 16)
layout_mode = 2
show_percentage = false

[node name="Notes" type="RichTextLabel" parent="Root/Col"]
layout_mode = 2
size_flags_vertical = 3
bbcode_enabled = false
fit_content = false
scroll_active = true
selection_enabled = true

[node name="Spacer" type="Control" parent="Root/Col"]
layout_mode = 2
size_flags_vertical = 3

[node name="Row" type="HBoxContainer" parent="Root/Col"]
layout_mode = 2
alignment = 2
theme_override_constants/separation = 6

[node name="Page" type="Button" parent="Root/Col/Row"]
layout_mode = 2
focus_mode = 0
text = "Release page"

[node name="Action" type="Button" parent="Root/Col/Row"]
layout_mode = 2
focus_mode = 0
text = "Check"

[node name="Close" type="Button" parent="Root/Col/Row"]
layout_mode = 2
focus_mode = 0
text = "Close"
