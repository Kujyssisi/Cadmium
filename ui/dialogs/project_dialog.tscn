; The song's own settings, as opposed to the machine's, which are in
; Preferences. What goes in the drop-downs is filled by project_dialog.gd.
[gd_scene load_steps=2 format=3 uid="uid://cdproject"]

[ext_resource type="Script" path="res://ui/dialogs/project_dialog.gd" id="1"]

[node name="ProjectDialog" type="Window"]
title = "Project Settings"
size = Vector2i(460, 260)
transient = true
script = ExtResource("1")

[node name="Root" type="PanelContainer" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_type_variation = &"Dialog"

[node name="Col" type="VBoxContainer" parent="Root"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="Heading" type="Label" parent="Root/Col"]
layout_mode = 2
theme_type_variation = &"SectionLabel"
text = "Time settings"

[node name="TimebaseRow" type="HBoxContainer" parent="Root/Col"]
layout_mode = 2

[node name="Label" type="Label" parent="Root/Col/TimebaseRow"]
custom_minimum_size = Vector2(150, 0)
layout_mode = 2
text = "Timebase (PPQ)"

[node name="Timebase" type="OptionButton" parent="Root/Col/TimebaseRow"]
layout_mode = 2
size_flags_horizontal = 3
focus_mode = 0
tooltip_text = "Ticks per quarter note in exported MIDI files. The editor itself works in beats, so this changes nothing you can hear."

[node name="PresetRow" type="HBoxContainer" parent="Root/Col"]
layout_mode = 2

[node name="Label" type="Label" parent="Root/Col/PresetRow"]
custom_minimum_size = Vector2(150, 0)
layout_mode = 2
text = "Set as time signature"

[node name="Preset" type="OptionButton" parent="Root/Col/PresetRow"]
layout_mode = 2
size_flags_horizontal = 3
focus_mode = 0
tooltip_text = "Fills the two below with a common signature"

[node name="NumeratorRow" type="HBoxContainer" parent="Root/Col"]
layout_mode = 2

[node name="Label" type="Label" parent="Root/Col/NumeratorRow"]
custom_minimum_size = Vector2(150, 0)
layout_mode = 2
text = "Numerator"

[node name="Numerator" type="SpinBox" parent="Root/Col/NumeratorRow"]
layout_mode = 2
size_flags_horizontal = 3
min_value = 1.0
max_value = 16.0
value = 4.0
tooltip_text = "Beats in a bar"

[node name="DenominatorRow" type="HBoxContainer" parent="Root/Col"]
layout_mode = 2

[node name="Label" type="Label" parent="Root/Col/DenominatorRow"]
custom_minimum_size = Vector2(150, 0)
layout_mode = 2
text = "Denominator"

[node name="Denominator" type="OptionButton" parent="Root/Col/DenominatorRow"]
layout_mode = 2
size_flags_horizontal = 3
focus_mode = 0
tooltip_text = "What note gets the beat"

[node name="Note" type="Label" parent="Root/Col"]
layout_mode = 2
autowrap_mode = 3
theme_type_variation = &"MuteLabel"
text = "Saved with the song."

[node name="Buttons" type="HBoxContainer" parent="Root/Col"]
layout_mode = 2
alignment = 2

[node name="Close" type="Button" parent="Root/Col/Buttons"]
layout_mode = 2
focus_mode = 0
text = "Close"
