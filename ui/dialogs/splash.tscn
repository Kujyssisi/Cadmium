; What is on screen while Cadmium starts: the mark, the name, and how far
; along it is. splash.gd drives the bar and closes the window.
[gd_scene load_steps=3 format=3 uid="uid://cdsplash"]

[ext_resource type="Script" path="res://ui/dialogs/splash.gd" id="1"]
[ext_resource type="Texture2D" path="res://icon.svg" id="2"]

[node name="Splash" type="Window"]
title = "Cadmium"
size = Vector2i(480, 210)
borderless = true
unresizable = true
script = ExtResource("1")

[node name="Root" type="PanelContainer" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_type_variation = &"Dialog"

[node name="Pad" type="MarginContainer" parent="Root"]
layout_mode = 2
theme_override_constants/margin_left = 22
theme_override_constants/margin_top = 20
theme_override_constants/margin_right = 22
theme_override_constants/margin_bottom = 18

[node name="Col" type="VBoxContainer" parent="Root/Pad"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Head" type="HBoxContainer" parent="Root/Pad/Col"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="Logo" type="TextureRect" parent="Root/Pad/Col/Head"]
custom_minimum_size = Vector2(76, 76)
layout_mode = 2
size_flags_vertical = 4
texture = ExtResource("2")
expand_mode = 1
stretch_mode = 5

[node name="Words" type="VBoxContainer" parent="Root/Pad/Col/Head"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 4
theme_override_constants/separation = 2

[node name="Name" type="Label" parent="Root/Pad/Col/Head/Words"]
layout_mode = 2
theme_override_font_sizes/font_size = 34
text = "Cadmium"

[node name="Tagline" type="Label" parent="Root/Pad/Col/Head/Words"]
layout_mode = 2
theme_type_variation = &"MuteLabel"
text = "A pattern-based digital audio workstation"

[node name="Version" type="Label" parent="Root/Pad/Col/Head/Words"]
layout_mode = 2
theme_type_variation = &"MuteLabel"
text = "Version"

[node name="Spacer" type="Control" parent="Root/Pad/Col"]
layout_mode = 2
size_flags_vertical = 3

[node name="Stage" type="Label" parent="Root/Pad/Col"]
layout_mode = 2
theme_type_variation = &"MuteLabel"
clip_text = true
text = "Starting up"

[node name="Bar" type="ProgressBar" parent="Root/Pad/Col"]
custom_minimum_size = Vector2(0, 12)
layout_mode = 2
max_value = 1.0
step = 0.001
show_percentage = false
