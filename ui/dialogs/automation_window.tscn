; The automation editor: one lane, drawn big enough to work on. The curve is
; drawn in automation_window.gd -- it is a graph, not a pile of controls -- and
; so are the knobs, which come from the same list the lane is stored under.
[gd_scene load_steps=2 format=3 uid="uid://cdautomationwindow"]

[ext_resource type="Script" path="res://ui/dialogs/automation_window.gd" id="1"]

[node name="AutomationWindow" type="Window"]
title = "Automation"
size = Vector2i(720, 480)
transient = true
script = ExtResource("1")

[node name="Root" type="PanelContainer" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_type_variation = &"Dialog"

[node name="Col" type="VBoxContainer" parent="Root"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="Head" type="HBoxContainer" parent="Root/Col"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="On" type="CheckBox" parent="Root/Col/Head"]
layout_mode = 2
focus_mode = 0
text = "On"
tooltip_text = "Switched off, the lane leaves its control alone."

[node name="Knobs" type="HBoxContainer" parent="Root/Col/Head"]
layout_mode = 2
theme_override_constants/separation = 2

[node name="ModeCol" type="VBoxContainer" parent="Root/Col/Head"]
layout_mode = 2
size_flags_vertical = 4
theme_override_constants/separation = 0

[node name="ModeLabel" type="Label" parent="Root/Col/Head/ModeCol"]
layout_mode = 2
text = "MODE"
theme_type_variation = &"SectionLabel"

[node name="Mode" type="OptionButton" parent="Root/Col/Head/ModeCol"]
custom_minimum_size = Vector2(140, 24)
layout_mode = 2
focus_mode = 0
tooltip_text = "Forced holds the control at the curve. Additive adds the curve to whatever the control is set to."

[node name="Spacer" type="Control" parent="Root/Col/Head"]
layout_mode = 2
size_flags_horizontal = 3

[node name="Editor" type="PanelContainer" parent="Root/Col"]
layout_mode = 2
size_flags_vertical = 3
theme_type_variation = &"DarkPanel"

[node name="View" type="Control" parent="Root/Col/Editor"]
layout_mode = 2

[node name="Target" type="PanelContainer" parent="Root/Col"]
layout_mode = 2
theme_type_variation = &"Card"

[node name="TargetCol" type="VBoxContainer" parent="Root/Col/Target"]
layout_mode = 2
theme_override_constants/separation = 2

[node name="Caption" type="Label" parent="Root/Col/Target/TargetCol"]
layout_mode = 2
text = "TARGET"
theme_type_variation = &"SectionLabel"

[node name="Links" type="VBoxContainer" parent="Root/Col/Target/TargetCol"]
layout_mode = 2
theme_override_constants/separation = 2

[node name="Row" type="HBoxContainer" parent="Root/Col/Target/TargetCol"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="Add" type="Button" parent="Root/Col/Target/TargetCol/Row"]
layout_mode = 2
focus_mode = 0
text = "Drive something else..."
tooltip_text = "One shape, one clip, several controls moving together"

[node name="Pad" type="Control" parent="Root/Col/Target/TargetCol/Row"]
layout_mode = 2
size_flags_horizontal = 3

[node name="Foot" type="HBoxContainer" parent="Root/Col"]
layout_mode = 2

[node name="Note" type="Label" parent="Root/Col/Foot"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 4
theme_type_variation = &"MuteLabel"

[node name="Flat" type="Button" parent="Root/Col/Foot"]
layout_mode = 2
focus_mode = 0
text = "Flatten"
tooltip_text = "One point, where the curve is at the start"

[node name="Close" type="Button" parent="Root/Col/Foot"]
layout_mode = 2
focus_mode = 0
text = "Close"
