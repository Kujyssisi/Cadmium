; Exporting audio or stems. Which of the two it is only changes two labels, so
; one scene covers both and export_dialog.gd sets them.
[gd_scene load_steps=2 format=3 uid="uid://cdexport"]

[ext_resource type="Script" path="res://ui/dialogs/export_dialog.gd" id="1"]

[node name="ExportDialog" type="Window"]
title = "Export Audio"
size = Vector2i(560, 330)
transient = true
exclusive = true
script = ExtResource("1")

[node name="Root" type="PanelContainer" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_type_variation = &"Dialog"

[node name="Col" type="VBoxContainer" parent="Root"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="PathRow" type="HBoxContainer" parent="Root/Col"]
layout_mode = 2

[node name="Label" type="Label" parent="Root/Col/PathRow"]
custom_minimum_size = Vector2(70, 0)
layout_mode = 2
text = "File"

[node name="Path" type="LineEdit" parent="Root/Col/PathRow"]
layout_mode = 2
size_flags_horizontal = 3

[node name="Browse" type="Button" parent="Root/Col/PathRow"]
layout_mode = 2
focus_mode = 0
text = "..."

[node name="FormatRow" type="HBoxContainer" parent="Root/Col"]
layout_mode = 2

[node name="Label" type="Label" parent="Root/Col/FormatRow"]
custom_minimum_size = Vector2(70, 0)
layout_mode = 2
text = "Format"

[node name="Bits" type="OptionButton" parent="Root/Col/FormatRow"]
layout_mode = 2
focus_mode = 0

[node name="RangeRow" type="HBoxContainer" parent="Root/Col"]
layout_mode = 2

[node name="Label" type="Label" parent="Root/Col/RangeRow"]
custom_minimum_size = Vector2(70, 0)
layout_mode = 2
text = "Range"

[node name="Range" type="OptionButton" parent="Root/Col/RangeRow"]
layout_mode = 2
focus_mode = 0

[node name="Length" type="Label" parent="Root/Col/RangeRow"]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"MuteLabel"
text = "0 bars"

[node name="TailRow" type="HBoxContainer" parent="Root/Col"]
layout_mode = 2

[node name="Label" type="Label" parent="Root/Col/TailRow"]
custom_minimum_size = Vector2(70, 0)
layout_mode = 2
text = "Tail"

[node name="Tail" type="SpinBox" parent="Root/Col/TailRow"]
layout_mode = 2
max_value = 60.0
step = 0.5
value = 2.0
suffix = "s"

[node name="Auto" type="CheckBox" parent="Root/Col/TailRow"]
layout_mode = 2
focus_mode = 0
text = "Automatic"
tooltip_text = "Render past the end until the sound has decayed, however long that takes"

[node name="Normalise" type="CheckBox" parent="Root/Col/TailRow"]
layout_mode = 2
focus_mode = 0
text = "Normalise"

[node name="LoopRow" type="HBoxContainer" parent="Root/Col"]
layout_mode = 2

[node name="Label" type="Label" parent="Root/Col/LoopRow"]
custom_minimum_size = Vector2(70, 0)
layout_mode = 2
text = "Loop"

[node name="Seamless" type="CheckBox" parent="Root/Col/LoopRow"]
layout_mode = 2
focus_mode = 0
text = "Seamless"
tooltip_text = "Fold the reverb tail back onto the start and cut the file to the range, so it loops with nothing to hear at the join"

[node name="Note" type="Label" parent="Root/Col/LoopRow"]
layout_mode = 2
size_flags_horizontal = 3
clip_text = true
theme_type_variation = &"MuteLabel"

[node name="Progress" type="ProgressBar" parent="Root/Col"]
layout_mode = 2
max_value = 1.0

[node name="Buttons" type="HBoxContainer" parent="Root/Col"]
layout_mode = 2
alignment = 2

[node name="Close" type="Button" parent="Root/Col/Buttons"]
layout_mode = 2
focus_mode = 0
text = "Close"

[node name="Go" type="Button" parent="Root/Col/Buttons"]
layout_mode = 2
focus_mode = 0
text = "Export"
theme_type_variation = &"Accent"
