; The sampler for one of the project's samples: what FL puts on an audio clip's
; channel. The knobs and switches are made in sample_window.gd from the same
; list the engine takes, so the two cannot drift apart.
[gd_scene load_steps=2 format=3 uid="uid://cdsamplewindow"]

[ext_resource type="Script" path="res://ui/dialogs/sample_window.gd" id="1"]

[node name="SampleWindow" type="Window"]
title = "Sampler"
size = Vector2i(560, 470)
transient = true
script = ExtResource("1")

[node name="Root" type="PanelContainer" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_type_variation = &"Dialog"

[node name="Col" type="VBoxContainer" parent="Root"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="Head" type="HBoxContainer" parent="Root/Col"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="File" type="Label" parent="Root/Col/Head"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 4
clip_text = true

[node name="MixerLabel" type="Label" parent="Root/Col/Head"]
layout_mode = 2
size_flags_vertical = 4
text = "Mixer"
theme_type_variation = &"MuteLabel"

[node name="Mixer" type="OptionButton" parent="Root/Col/Head"]
custom_minimum_size = Vector2(120, 0)
layout_mode = 2
size_flags_vertical = 4
focus_mode = 0
tooltip_text = "The mixer track this sample plays through, so effects can be put on it"

[node name="Replace" type="Button" parent="Root/Col/Head"]
layout_mode = 2
focus_mode = 0
text = "Replace..."
tooltip_text = "Play a different file through the same clips"

[node name="Levels" type="HBoxContainer" parent="Root/Col"]
layout_mode = 2
theme_override_constants/separation = 2

[node name="Stretch" type="PanelContainer" parent="Root/Col"]
layout_mode = 2
theme_type_variation = &"Card"

[node name="StretchCol" type="VBoxContainer" parent="Root/Col/Stretch"]
layout_mode = 2
theme_override_constants/separation = 2

[node name="Caption" type="Label" parent="Root/Col/Stretch/StretchCol"]
layout_mode = 2
text = "TIME STRETCHING"
theme_type_variation = &"SectionLabel"

[node name="Row" type="HBoxContainer" parent="Root/Col/Stretch/StretchCol"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="Knobs" type="HBoxContainer" parent="Root/Col/Stretch/StretchCol/Row"]
layout_mode = 2
theme_override_constants/separation = 2

[node name="ModeCol" type="VBoxContainer" parent="Root/Col/Stretch/StretchCol/Row"]
layout_mode = 2
size_flags_vertical = 4
theme_override_constants/separation = 0

[node name="ModeLabel" type="Label" parent="Root/Col/Stretch/StretchCol/Row/ModeCol"]
layout_mode = 2
text = "MODE"
theme_type_variation = &"SectionLabel"

[node name="Mode" type="OptionButton" parent="Root/Col/Stretch/StretchCol/Row/ModeCol"]
custom_minimum_size = Vector2(150, 24)
layout_mode = 2
focus_mode = 0

[node name="Effects" type="PanelContainer" parent="Root/Col"]
layout_mode = 2
theme_type_variation = &"Card"

[node name="EffectsCol" type="VBoxContainer" parent="Root/Col/Effects"]
layout_mode = 2
theme_override_constants/separation = 2

[node name="Caption" type="Label" parent="Root/Col/Effects/EffectsCol"]
layout_mode = 2
text = "PRECOMPUTED EFFECTS"
theme_type_variation = &"SectionLabel"

[node name="Switches" type="HFlowContainer" parent="Root/Col/Effects/EffectsCol"]
layout_mode = 2

[node name="Knobs" type="HBoxContainer" parent="Root/Col/Effects/EffectsCol"]
layout_mode = 2
theme_override_constants/separation = 2

[node name="Wave" type="PanelContainer" parent="Root/Col"]
custom_minimum_size = Vector2(0, 120)
layout_mode = 2
size_flags_vertical = 3
theme_type_variation = &"DarkPanel"

[node name="View" type="Control" parent="Root/Col/Wave"]
layout_mode = 2

[node name="Foot" type="HBoxContainer" parent="Root/Col"]
layout_mode = 2

[node name="Note" type="Label" parent="Root/Col/Foot"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 4
theme_type_variation = &"MuteLabel"

[node name="Reset" type="Button" parent="Root/Col/Foot"]
layout_mode = 2
focus_mode = 0
text = "Reset"

[node name="Close" type="Button" parent="Root/Col/Foot"]
layout_mode = 2
focus_mode = 0
text = "Close"
