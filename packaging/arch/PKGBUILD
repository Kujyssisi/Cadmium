# Maintainer: cfinite <https://github.com/Kujyssisi/Cadmium>
#
# The Arch-native way to install Cadmium, for anyone who would rather have a
# package than a folder. It takes the published release zip rather than
# building from source: the audio engine needs a Godot export template and a
# matching Godot binary, which is a lot to ask of a package build, and the zip
# is what is tested and published.
#
#   cd packaging/arch && makepkg -si
#
# Everything else is the same install.sh does, in the places a package puts
# them: /usr/lib/cadmium for the program, /usr/bin/cadmium for the launcher.

pkgname=cadmium-bin
_pkgname=Cadmium
pkgver=2026.09.20
pkgrel=1
pkgdesc="Pattern-based digital audio workstation: channel rack, piano roll, playlist, mixer, VST3"
arch=('x86_64')
url="https://github.com/Kujyssisi/Cadmium"
license=('GPL-3.0-or-later')
depends=('alsa-lib' 'libx11' 'libxcursor' 'libxinerama' 'libxi' 'libxrandr' 'vulkan-icd-loader')
optdepends=('ffmpeg: load and export audio in anything other than WAV')
provides=('cadmium')
conflicts=('cadmium')
options=('!strip')
source=("$pkgname-$pkgver.zip::$url/releases/download/v$pkgver/$_pkgname-$pkgver-linux-x86_64.zip")
# Filled in by `updpkgsums`, or by whoever cuts the release.
sha256sums=('SKIP')

package() {
	local src="$srcdir/$_pkgname-$pkgver-linux-x86_64"
	local dest="$pkgdir/usr/lib/cadmium"

	install -d "$dest"
	install -Dm755 "$src/Cadmium.x86_64" "$dest/Cadmium.x86_64"
	install -Dm644 "$src/Cadmium.pck"    "$dest/Cadmium.pck"
	install -Dm755 "$src"/libcadmium.*.so -t "$dest"

	# The soundfont and the FLARE banks are read from beside the executable, so
	# they are part of the program rather than shared data.
	cp -r "$src/Content" "$src/Banks" "$dest/"
	find "$dest/Content" "$dest/Banks" -type f -exec chmod 644 {} +

	# A launcher rather than a symlink: the engine and the content are found
	# relative to the executable.
	install -d "$pkgdir/usr/bin"
	cat > "$pkgdir/usr/bin/cadmium" <<-LAUNCHER
		#!/usr/bin/env sh
		exec /usr/lib/cadmium/Cadmium.x86_64 "\$@"
	LAUNCHER
	chmod 755 "$pkgdir/usr/bin/cadmium"

	# The menu entry, the icon and what a .cadmium file is.
	sed 's|@EXEC@|/usr/lib/cadmium/Cadmium.x86_64|g' "$src/packaging/cadmium.desktop" \
		> "$srcdir/cadmium.desktop"
	install -Dm644 "$srcdir/cadmium.desktop" \
		"$pkgdir/usr/share/applications/cadmium.desktop"
	install -Dm644 "$src/packaging/icon.svg" \
		"$pkgdir/usr/share/icons/hicolor/scalable/apps/cadmium.svg"
	install -Dm644 "$src/packaging/cadmium-project.xml" \
		"$pkgdir/usr/share/mime/packages/cadmium-project.xml"

	install -Dm644 "$src/LICENSE.txt" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
	install -Dm644 "$src/THIRD-PARTY-NOTICES.md" \
		"$pkgdir/usr/share/licenses/$pkgname/THIRD-PARTY-NOTICES.md"
	install -Dm644 "$src/THIRD-PARTY-GODOT.txt" \
		"$pkgdir/usr/share/licenses/$pkgname/THIRD-PARTY-GODOT.txt"
}
